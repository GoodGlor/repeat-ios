# Xcode
build/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/

# Swift Package Manager
# NOT `Packages/` — our own source packages live there (Packages/Scheduling).
# That rule silently excluded the whole Scheduling package in #4 and left main
# referencing a package that was not in the repository.
.build/
.swiftpm/
Package.resolved

# Secrets — never commit service-account keys or API keys.
# Google names a downloaded key after the project and key id, not the word
# "service-account" — so match that shape too, not just the obvious name.
*.pem
*-service-account*.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.json
Secrets.plist
.env
*.env
/secrets/
Config/live.env
# The baked-in default connection (#78). Generated by
# scripts/set-default-connection.sh; contains the whole service-account key.
Config/DefaultConnection.json

# macOS
.DS_Store

# XcodeGen output — regenerate with `xcodegen generate`.
# project.yml is the single source of truth for all of these.
*.xcodeproj/
Repeat/Info.plist
Repeat/Repeat.entitlements
RepeatWidget/Info.plist
RepeatWidget/RepeatWidget.entitlements
RepeatShareExtension/Info.plist
RepeatShareExtension/RepeatShareExtension.entitlements

# Per-machine signing config
Config/Local.xcconfig

# Worktrees created by the worktree-from-card skill
.claude/worktrees/

# Subagent-driven-development scratch: ledgers, briefs, review packages. Rulings are copied into the PR and the handoff before it is deleted.
.superpowers/
