            "state": "translated",
            "value": "×"
          }
        }
      }
    },
    "Їх відкладено, щоб вони не займали сесію. Перепиши або видали.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are set aside so they do not take up the session. Rewrite or delete them."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їх відкладено, щоб вони не займали сесію. Перепиши або видали."
          }
        }
      }
    },
