# Copy to Config/live.env (gitignored) to enable the live Sheets check.
#
#   cp Config/live.env.template Config/live.env
#   scripts/live-check.sh
#
# The service-account key stays wherever you downloaded it. Do not move it into
# the repository: a key in git history is permanent, and a private repo is not a
# secret store.
export REPEAT_LIVE_KEY_PATH="/absolute/path/to/service-account-key.json"
export REPEAT_LIVE_SHEET_ID="the-id-from-the-sheet-url"
